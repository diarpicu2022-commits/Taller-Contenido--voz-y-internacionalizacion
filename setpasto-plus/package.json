{
  "name": "setpasto-plus",
  "version": "1.0.0",
  "description": "Rediseño accesible y multilingüe del portal SETPasto — taller de contenido, voz e internacionalización",
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "build": "npm run vendor && npm run css:build",
    "css:build": "tailwindcss -i ./src/css/input.css -o ./public/css/app.css --minify",
    "css:watch": "tailwindcss -i ./src/css/input.css -o ./public/css/app.css --watch",
    "vendor": "node scripts/copy-vendor.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "compression": "^1.8.1",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "animejs": "^3.2.2",
    "autoprefixer": "^10.5.4",
    "chart.js": "^4.5.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  }
}

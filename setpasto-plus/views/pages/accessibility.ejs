<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main">
  <section class="relative overflow-hidden border-b" style="border-color: var(--line)">
    <%- include('../partials/topo') %>
    <div class="relative mx-auto max-w-[1400px] px-4 py-14 sm:px-6 lg:py-20">
      <p class="eyebrow flex items-center gap-3"><span class="inline-block h-px w-8" style="background: var(--accent)"></span>WCAG 2.2 AA</p>
      <h1 class="mt-4 max-w-3xl font-display text-[clamp(2.2rem,5.5vw,3.6rem)] font-extrabold leading-[1] tracking-[-0.03em] text-balance"><%= t('a11y.title') %></h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty" style="color: var(--text-soft)"><%= t('a11y.lead') %></p>
    </div>
  </section>

  <section class="mx-auto grid max-w-[1400px] grid-cols-12 gap-6 px-4 py-12 sm:px-6 lg:gap-10 lg:py-16">

    <!-- Panel de ajustes de lectura -->
    <div class="col-span-12 lg:col-span-5">
      <div class="card sticky top-28 p-6 lg:p-7">
        <h2 class="font-display text-xl font-extrabold tracking-tight"><%= t('a11y.settingsTitle') %></h2>
        <p class="mt-2 text-sm" style="color: var(--text-soft)"><%= t('a11y.settingsLead') %></p>

        <div class="mt-6 space-y-6" data-a11y-panel>
          <fieldset>
            <legend class="text-sm font-semibold"><%= t('a11y.fontSize') %></legend>
            <div class="mt-3 flex flex-wrap gap-2">
              <% [['100%', t('a11y.fontSizeSmall')], ['112.5%', t('a11y.fontSizeLarge')], ['125%', t('a11y.fontSizeXl')]].forEach(function (o) { %>
                <button type="button" class="btn btn-ghost" data-font="<%= o[0] %>" aria-pressed="false"><%= o[1] %></button>
              <% }); %>
            </div>
          </fieldset>

          <% const toggles = [
               { key: 'contrast',  label: t('a11y.contrast') },
               { key: 'underline', label: t('a11y.underline') },
               { key: 'motion',    label: t('a11y.motion') }
             ]; %>
          <% toggles.forEach(function (tg) { %>
            <div class="flex items-center justify-between gap-4">
              <span class="text-sm font-medium"><%= tg.label %></span>
              <button type="button" role="switch" aria-checked="false" data-toggle="<%= tg.key %>"
                      class="relative h-7 w-12 shrink-0 rounded-full border transition-colors"
                      style="border-color: var(--line); background: var(--surface-sunk)">
                <span class="absolute start-0.5 top-1/2 h-5 w-5 -translate-y-1/2 rounded-full transition-transform"
                      style="background: var(--text-mute)"></span>
                <span class="sr-only"><%= tg.label %></span>
              </button>
            </div>
          <% }); %>

          <button type="button" class="btn btn-ghost w-full justify-center" data-a11y-reset><%= t('a11y.reset') %></button>
        </div>
      </div>
    </div>

    <!-- Estado de conformidad -->
    <div class="col-span-12 lg:col-span-7">
      <h2 class="font-display text-2xl font-extrabold tracking-tight"><%= t('a11y.conformanceTitle') %></h2>
      <ul class="mt-6 grid gap-3">
        <% t('a11y.conformance').forEach(function (c) { %>
          <li class="card flex items-start gap-4 p-5" data-reveal>
            <span class="mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-lg"
                  style="background: color-mix(in oklab, <%= c.state === 'ok' ? 'var(--cat-1)' : 'var(--cat-2)' %> 16%, transparent); color: <%= c.state === 'ok' ? 'var(--cat-1)' : 'var(--cat-2)' %>">
              <% if (c.state === 'ok') { %>
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" aria-hidden="true"><path d="m5 13 4 4 10-10" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <% } else { %>
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" aria-hidden="true"><path d="M12 8v5m0 3.5v.2" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/></svg>
              <% } %>
            </span>
            <div>
              <h3 class="font-semibold"><%= c.criterion %></h3>
              <p class="mt-1 text-sm" style="color: var(--text-soft)"><%= c.note %></p>
              <p class="mt-2 font-mono text-[11px] uppercase tracking-widest"
                 style="color: <%= c.state === 'ok' ? 'var(--cat-1)' : 'var(--cat-2)' %>">
                <%= c.state === 'ok' ? t('a11y.stateOk') : t('a11y.statePartial') %>
              </p>
            </div>
          </li>
        <% }); %>
      </ul>

      <div class="card mt-8 p-6" style="background: color-mix(in oklab, var(--brand) 8%, var(--surface-raised))">
        <h2 class="font-display text-xl font-extrabold tracking-tight"><%= t('a11y.helpTitle') %></h2>
        <p class="mt-2 text-sm leading-relaxed" style="color: var(--text-soft)"><%= t('a11y.helpText') %></p>
        <a href="<%= href('/pqrs') %>" class="btn btn-primary mt-5 no-underline"><%= t('pqrs.submit') %></a>
      </div>
    </div>
  </section>
</main>

<%- include('../partials/footer', { pageScript: 'a11y.js' }) %>

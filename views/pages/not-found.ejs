<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main" class="relative overflow-hidden">
  <%- include('../partials/topo') %>
  <div class="relative mx-auto flex min-h-[60vh] max-w-[1400px] flex-col items-start justify-center px-4 py-20 sm:px-6">
    <p class="font-mono text-sm uppercase tracking-[.3em]" style="color: var(--text-mute)">404</p>
    <h1 class="mt-4 max-w-2xl font-display text-[clamp(2.2rem,6vw,4rem)] font-extrabold leading-[1] tracking-[-0.03em] text-balance">
      <%= t('routes.notFound') %>
    </h1>
    <p class="mt-5 max-w-xl text-lg" style="color: var(--text-soft)"><%= t('common.noResultsHint') %></p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="<%= href('/') %>" class="btn btn-primary no-underline"><%= t('nav.home') %></a>
      <a href="<%= href('/rutas') %>" class="btn btn-ghost no-underline"><%= t('nav.rutas') %></a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

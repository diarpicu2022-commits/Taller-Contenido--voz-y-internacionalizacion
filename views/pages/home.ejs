<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main">

  <!-- ============================ HERO ============================ -->
  <section class="relative overflow-hidden grain-overlay">
    <%- include('../partials/topo') %>

    <div class="relative mx-auto grid max-w-[1400px] grid-cols-12 gap-6 px-4 pb-16 pt-14 sm:px-6 lg:gap-8 lg:pb-24 lg:pt-20">

      <div class="col-span-12 lg:col-span-7 xl:col-span-6">
        <p class="eyebrow flex items-center gap-3" data-reveal>
          <span class="inline-block h-px w-8" style="background: var(--accent)"></span>
          <%= t('hero.eyebrow') %>
        </p>

        <h1 class="mt-5 font-display text-[clamp(2.6rem,7vw,4.8rem)] font-extrabold leading-[0.95] tracking-[-0.03em] text-balance" data-reveal>
          <%= t('hero.title') %>
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-pretty" style="color: var(--text-soft)" data-reveal>
          <%= t('hero.lead') %>
        </p>

        <!-- Buscador: funciona sin JavaScript, envía a /rutas?q= -->
        <form class="mt-8 max-w-xl" action="<%= href('/rutas') %>" method="get" role="search" data-reveal>
          <label for="q" class="sr-only"><%= t('hero.searchLabel') %></label>
          <div class="flex flex-col gap-2 sm:flex-row sm:items-stretch">
            <div class="relative flex-1">
              <svg viewBox="0 0 24 24" class="pointer-events-none absolute start-4 top-1/2 h-5 w-5 -translate-y-1/2" fill="none" aria-hidden="true" style="color: var(--text-mute)">
                <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/>
                <path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
              <input id="q" name="q" type="search" autocomplete="off"
                     placeholder="<%= t('hero.searchPlaceholder') %>"
                     class="w-full rounded-xl border py-4 ps-12 pe-4 text-base outline-none transition-shadow placeholder:opacity-60 focus:shadow-lift"
                     style="background: var(--surface-raised); border-color: var(--line); color: var(--text)">
            </div>
            <button class="btn btn-primary justify-center px-7 py-4 text-base" type="submit"><%= t('hero.searchSubmit') %></button>
          </div>
        </form>

        <div class="mt-5 flex flex-wrap items-center gap-2" data-reveal>
          <span class="eyebrow me-1"><%= t('hero.quick') %></span>
          <% t('hero.quickItems').forEach(function (item) { %>
            <a href="<%= href('/rutas') %>?q=<%= encodeURIComponent(item) %>"
               class="rounded-full border px-3 py-1.5 text-xs no-underline transition-colors hover:border-current"
               style="border-color: var(--line); color: var(--text-soft)"><%= item %></a>
          <% }); %>
        </div>
      </div>

      <!-- Tarjeta de tarifa: el dato más buscado, que en el portal original
           no aparecía en ninguna parte. -->
      <div class="col-span-12 flex lg:col-span-5 lg:col-start-8 xl:col-span-4 xl:col-start-9" data-reveal>
        <div class="card relative w-full overflow-hidden p-7 shadow-card">
          <div class="absolute inset-x-0 top-0 h-1.5 bg-stripe-signage"></div>
          <p class="eyebrow"><%= t('fare.title') %></p>
          <p class="mt-3 flex items-baseline gap-2">
            <span class="font-display text-5xl font-extrabold tracking-tight" dir="ltr"><%= fmt.currency.format(overview.fare) %></span>
            <span class="text-sm" style="color: var(--text-mute)"><%= t('fare.unit') %></span>
          </p>
          <p class="mt-4 text-sm leading-relaxed" style="color: var(--text-soft)"><%= t('fare.note') %></p>
          <p class="mt-2 text-sm leading-relaxed" style="color: var(--text-soft)">
            <%= t('fare.special', { price: fmt.currency.format(overview.fareReduced) }) %>
          </p>

          <div class="mt-6 flex flex-wrap gap-2">
            <a href="<%= href('/rutas') %>" class="btn btn-primary no-underline"><%= t('hero.ctaRoutes') %>
              <svg viewBox="0 0 24 24" class="h-4 w-4 flip-rtl" fill="none" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a href="<%= href('/indicadores') %>" class="btn btn-ghost no-underline"><%= t('hero.ctaIndicators') %></a>
          </div>
        </div>
      </div>

      <!-- Cifras del sistema -->
      <dl class="col-span-12 mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border md:grid-cols-4"
          style="border-color: var(--line); background: var(--line)" data-reveal>
        <% const stats = [
             { v: overview.rutas,        l: t('hero.statRutas'),        fmtKind: 'int' },
             { v: overview.paraderos,    l: t('hero.statParaderos'),    fmtKind: 'int' },
             { v: overview.viajesMes,    l: t('hero.statViajes'),       fmtKind: 'compact' },
             { v: overview.puntualidad,  l: t('hero.statPuntualidad'),  fmtKind: 'percent' }
           ]; %>
        <% stats.forEach(function (s) { %>
          <div class="p-6" style="background: var(--surface)">
            <dd class="font-display text-4xl font-extrabold tracking-tight" dir="ltr"
                data-count="<%= s.v %>" data-count-kind="<%= s.fmtKind %>"><%=
                  s.fmtKind === 'percent' ? fmt.percent.format(s.v)
                  : s.fmtKind === 'compact' ? fmt.compact.format(s.v)
                  : fmt.number.format(s.v) %></dd>
            <dt class="mt-2 text-sm" style="color: var(--text-mute)"><%= s.l %></dt>
          </div>
        <% }); %>
      </dl>
    </div>
  </section>

  <!-- ========================= TAREAS PRINCIPALES ========================= -->
  <section class="mx-auto max-w-[1400px] px-4 py-16 sm:px-6 lg:py-24">
    <div class="grid grid-cols-12 gap-6 lg:gap-8">
      <header class="col-span-12 lg:col-span-4">
        <h2 class="font-display text-3xl font-extrabold tracking-tight text-balance lg:text-4xl" data-reveal><%= t('services.title') %></h2>
        <p class="mt-4 text-base leading-relaxed" style="color: var(--text-soft)" data-reveal><%= t('services.lead') %></p>
        <div class="rule-diagonal mt-6 w-24" data-reveal></div>
      </header>

      <div class="col-span-12 grid gap-4 sm:grid-cols-2 lg:col-span-8">
        <% const serviceHrefs = [href('/rutas'), href('/rutas'), href('/rutas'), href('/pqrs')]; %>
        <% t('services.items').forEach(function (item, i) { %>
          <a href="<%= serviceHrefs[i] %>" class="card card-hover group flex flex-col p-6 no-underline" data-reveal>
            <span class="grid h-11 w-11 place-items-center rounded-xl font-mono text-sm font-semibold"
                  style="background: color-mix(in oklab, var(--cat-<%= i + 1 %>) 16%, transparent); color: var(--cat-<%= i + 1 %>)">
              <%= String(i + 1).padStart(2, '0') %>
            </span>
            <h3 class="mt-4 font-display text-xl font-bold tracking-tight"><%= item.title %></h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed" style="color: var(--text-soft)"><%= item.text %></p>
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold" style="color: var(--brand)">
              <%= item.cta %>
              <svg viewBox="0 0 24 24" class="h-4 w-4 flip-rtl transition-transform duration-300 group-hover:translate-x-1" fill="none" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </a>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ============================ VOZ Y TONO ============================ -->
  <section class="relative overflow-hidden border-y" style="border-color: var(--line); background: var(--surface-sunk)">
    <div class="mx-auto max-w-[1400px] px-4 py-16 sm:px-6 lg:py-24">
      <div class="grid grid-cols-12 gap-6 lg:gap-8">
        <header class="col-span-12 lg:col-span-5">
          <p class="eyebrow" data-reveal>02 — <%= t('voice.title') %></p>
          <h2 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-balance lg:text-4xl" data-reveal><%= t('voice.title') %></h2>
          <p class="mt-4 max-w-md text-base leading-relaxed" style="color: var(--text-soft)" data-reveal><%= t('voice.lead') %></p>
        </header>

        <ul class="col-span-12 grid gap-4 lg:col-span-7">
          <% t('voice.principles').forEach(function (p) { %>
            <li class="card p-6" data-reveal>
              <h3 class="font-display text-lg font-bold tracking-tight"><%= p.title %></h3>
              <div class="mt-4 grid gap-3 md:grid-cols-2">
                <div class="rounded-xl border p-4" style="border-color: var(--line)">
                  <p class="eyebrow" style="color: var(--cat-4)"><%= t('voice.beforeLabel') %></p>
                  <p class="mt-2 text-sm leading-relaxed line-through decoration-1" style="color: var(--text-mute)"><%= p.before %></p>
                </div>
                <div class="rounded-xl border-2 p-4" style="border-color: color-mix(in oklab, var(--brand) 45%, transparent); background: color-mix(in oklab, var(--brand) 7%, transparent)">
                  <p class="eyebrow" style="color: var(--brand)"><%= t('voice.afterLabel') %></p>
                  <p class="mt-2 text-sm font-medium leading-relaxed"><%= p.after %></p>
                </div>
              </div>
            </li>
          <% }); %>
        </ul>
      </div>
    </div>
  </section>

  <!-- ======================= RUTAS DESTACADAS ======================= -->
  <section class="mx-auto max-w-[1400px] px-4 py-16 sm:px-6 lg:py-24">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow" data-reveal>03 — <%= t('routes.title') %></p>
        <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight lg:text-4xl" data-reveal><%= t('routes.title') %></h2>
      </div>
      <a href="<%= href('/rutas') %>" class="btn btn-ghost no-underline" data-reveal><%= t('common.seeAll') %>
        <svg viewBox="0 0 24 24" class="h-4 w-4 flip-rtl" fill="none" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <ul class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-7">
      <% routes.filter(function (r) { return r.id[0] === 'E'; }).forEach(function (r) { %>
        <li data-reveal>
          <a href="<%= href('/rutas/' + r.id) %>" class="card card-hover flex h-full flex-col gap-3 p-4 no-underline">
            <span class="badge-ruta self-start" data-fam="<%= r.id[0] %>"><%= r.id %></span>
            <span class="text-sm font-semibold leading-snug"><%= r.from %> — <%= r.to %></span>
            <span class="mt-auto font-mono text-[11px]" style="color: var(--text-mute)"><%= t('routes.frequencyValue', { n: r.headway }) %></span>
          </a>
        </li>
      <% }); %>
    </ul>
  </section>

  <!-- ==================== INTERNACIONALIZACIÓN EN VIVO ==================== -->
  <section class="mx-auto max-w-[1400px] px-4 pb-16 sm:px-6 lg:pb-24">
    <div class="card relative overflow-hidden p-7 lg:p-10" data-reveal>
      <div class="absolute inset-y-0 start-0 w-1.5" style="background: var(--accent)"></div>
      <div class="grid grid-cols-12 gap-6 lg:gap-10">
        <header class="col-span-12 lg:col-span-4">
          <p class="eyebrow">04 — Intl API</p>
          <h2 class="mt-3 font-display text-2xl font-extrabold tracking-tight lg:text-3xl"><%= t('i18nDemo.title') %></h2>
          <p class="mt-4 text-sm leading-relaxed" style="color: var(--text-soft)"><%= t('i18nDemo.lead') %></p>
          <p class="mt-4 font-mono text-xs" style="color: var(--text-mute)">
            <%= t('i18nDemo.dirNote', { dir: dir }) %> · <code>lang="<%= ctx.tag %>"</code>
          </p>
        </header>

        <dl class="col-span-12 grid gap-px overflow-hidden rounded-xl border sm:grid-cols-2 lg:col-span-8 xl:grid-cols-3"
            style="border-color: var(--line); background: var(--line)">
          <% const demo = [
               { l: t('i18nDemo.dateLabel'),     v: fmt.dateFull.format(now) },
               { l: t('i18nDemo.timeLabel'),     v: fmt.time.format(now) },
               { l: t('i18nDemo.numberLabel'),   v: fmt.number.format(1284000) },
               { l: t('i18nDemo.currencyLabel'), v: fmt.currency.format(overview.fare) },
               { l: t('i18nDemo.relativeLabel'), v: ctx.relativeDays('2026-08-11') },
               { l: t('i18nDemo.pluralLabel'),   v: plural('i18nDemo.plural', 3) },
               { l: t('i18nDemo.listLabel'),     v: fmt.list.format(['C4', 'C11', 'E2']) }
             ]; %>
          <% demo.forEach(function (d) { %>
            <div class="p-4" style="background: var(--surface-raised)">
              <dt class="eyebrow"><%= d.l %></dt>
              <dd class="mt-2 font-mono text-sm font-medium"><%= d.v %></dd>
            </div>
          <% }); %>
        </dl>
      </div>
    </div>
  </section>

  <!-- ============================== NOTICIAS ============================== -->
  <section class="mx-auto max-w-[1400px] px-4 pb-20 sm:px-6 lg:pb-28">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow" data-reveal>05 — <%= t('news.title') %></p>
        <h2 class="mt-3 font-display text-3xl font-extrabold tracking-tight lg:text-4xl" data-reveal><%= t('news.title') %></h2>
        <p class="mt-3 max-w-xl text-sm" style="color: var(--text-soft)" data-reveal><%= t('news.lead') %></p>
      </div>
    </div>

    <ul class="mt-8 grid gap-5 md:grid-cols-3">
      <% const kickerMap = { obra: t('news.kickerObra'), operacion: t('news.kickerOperacion'), cultura: t('news.kickerCultura') };
         const kickerColor = { obra: 'var(--cat-2)', operacion: 'var(--cat-1)', cultura: 'var(--cat-5)' }; %>
      <% t('news.items').forEach(function (item) { %>
        <li class="card card-hover flex flex-col overflow-hidden" data-reveal>
          <div class="relative h-2" style="background: <%= kickerColor[item.kicker] %>"></div>
          <div class="flex flex-1 flex-col p-6">
            <p class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <span class="font-mono text-[11px] uppercase tracking-[.18em]" style="color: <%= kickerColor[item.kicker] %>"><%= kickerMap[item.kicker] %></span>
              <time datetime="<%= item.date %>" class="text-xs" style="color: var(--text-mute)">
                <%= fmt.dateLong.format(new Date(item.date + 'T12:00:00Z')) %> · <%= ctx.relativeDays(item.date) %>
              </time>
            </p>
            <h3 class="mt-3 font-display text-xl font-bold leading-snug tracking-tight text-balance"><%= item.title %></h3>
            <p class="mt-3 flex-1 text-sm leading-relaxed" style="color: var(--text-soft)"><%= item.text %></p>
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold" style="color: var(--brand)">
              <%= t('common.seeMore') %>
              <svg viewBox="0 0 24 24" class="h-4 w-4 flip-rtl" fill="none" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </div>
        </li>
      <% }); %>
    </ul>
  </section>

  <!-- ============================== CTA AUDITORÍA ============================== -->
  <section class="mx-auto max-w-[1400px] px-4 pb-24 sm:px-6">
    <a href="<%= href('/auditoria') %>" class="card card-hover flex flex-col items-start gap-5 overflow-hidden p-8 no-underline md:flex-row md:items-center md:justify-between lg:p-10" data-reveal
       style="background: var(--brand); border-color: transparent">
      <div class="max-w-2xl text-white">
        <p class="font-mono text-[11px] uppercase tracking-[.22em] opacity-80"><%= t('nav.auditoria') %></p>
        <h2 class="mt-3 font-display text-2xl font-extrabold tracking-tight text-balance lg:text-3xl"><%= t('audit.title') %></h2>
        <p class="mt-3 text-sm leading-relaxed opacity-90"><%= t('audit.lead') %></p>
      </div>
      <span class="btn btn-accent shrink-0"><%= t('common.seeMore') %>
        <svg viewBox="0 0 24 24" class="h-4 w-4 flip-rtl" fill="none" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </a>
  </section>

</main>

<%- include('../partials/footer') %>

<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main id="main">
  <nav class="mx-auto max-w-[1400px] px-4 pt-6 sm:px-6" aria-label="breadcrumb">
    <a href="<%= href('/rutas') %>" class="link-underline inline-flex items-center gap-2 text-sm" style="color: var(--text-soft)">
      <svg viewBox="0 0 24 24" class="h-4 w-4 flip-rtl rotate-180" fill="none" aria-hidden="true"><path d="M5 12h13m-5-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <%= t('routes.detailBack') %>
    </a>
  </nav>

  <section class="mx-auto max-w-[1400px] px-4 py-8 sm:px-6 lg:py-12">
    <div class="grid grid-cols-12 gap-6 lg:gap-8">

      <header class="col-span-12 lg:col-span-7">
        <div class="flex flex-wrap items-center gap-4">
          <span class="badge-ruta !px-4 !py-3 !text-2xl" data-fam="<%= route.id[0] %>"><%= route.id %></span>
          <h1 class="font-display text-[clamp(1.8rem,4.5vw,3rem)] font-extrabold leading-[1.05] tracking-[-0.03em]">
            <%= route.from %> <span style="color: var(--text-mute)">—</span> <%= route.to %>
          </h1>
        </div>

        <dl class="mt-8 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border sm:grid-cols-4"
            style="border-color: var(--line); background: var(--line)">
          <div class="p-5" style="background: var(--surface-raised)">
            <dt class="eyebrow"><%= t('routes.detailFrequency') %></dt>
            <dd class="mt-2 font-display text-2xl font-extrabold"><%= t('routes.frequencyValue', { n: route.headway }) %></dd>
          </div>
          <div class="p-5" style="background: var(--surface-raised)">
            <dt class="eyebrow"><%= t('routes.detailSpan') %></dt>
            <dd class="mt-2 font-mono text-lg font-semibold" dir="ltr"><%= route.spanFrom %>–<%= route.spanTo %></dd>
          </div>
          <div class="p-5" style="background: var(--surface-raised)">
            <dt class="eyebrow"><%= t('routes.detailLength') %></dt>
            <dd class="mt-2 font-display text-2xl font-extrabold" dir="ltr"><%= fmt.number.format(route.km) %> km</dd>
          </div>
          <div class="p-5" style="background: var(--surface-raised)">
            <dt class="eyebrow"><%= t('routes.detailFleet') %></dt>
            <dd class="mt-2 font-display text-2xl font-extrabold"><%= fmt.number.format(route.fleet) %></dd>
          </div>
        </dl>

        <p class="mt-6">
          <% if (route.low) { %>
            <span class="inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold"
                  style="background: color-mix(in oklab, var(--cat-1) 15%, transparent); color: var(--cat-1)">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" aria-hidden="true"><path d="m5 13 4 4 10-10" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <%= t('routes.accessible') %>
            </span>
          <% } else { %>
            <span class="inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm" style="border-color: var(--line); color: var(--text-mute)">
              <%= t('routes.notAccessible') %>
            </span>
          <% } %>
        </p>
      </header>

      <!-- Recorrido: una línea de señalética, no un mapa que nadie puede leer -->
      <div class="col-span-12 lg:col-span-5">
        <h2 class="eyebrow"><%= t('routes.detailStops') %></h2>
        <ol class="relative mt-5 ps-8">
          <span class="absolute inset-y-3 start-[7px] w-0.5 rounded-full" style="background: color-mix(in oklab, var(--brand) 40%, transparent)"></span>
          <% stops.forEach(function (stop, i) { %>
            <li class="relative pb-6 last:pb-0" data-reveal>
              <span class="absolute -start-8 top-1 grid h-4 w-4 place-items-center rounded-full border-2"
                    style="border-color: var(--brand); background: var(--surface); <%= (i === 0 || i === stops.length - 1) ? 'background: var(--brand)' : '' %>"></span>
              <p class="text-sm font-semibold"><%= stop %></p>
              <% if (i === 0) { %><p class="mt-0.5 font-mono text-[11px] uppercase tracking-widest" style="color: var(--text-mute)"><%= t('routes.firstStop') %></p><% } %>
              <% if (i === stops.length - 1) { %><p class="mt-0.5 font-mono text-[11px] uppercase tracking-widest" style="color: var(--text-mute)"><%= t('routes.lastStop') %></p><% } %>
            </li>
          <% }); %>
        </ol>
      </div>
    </div>
  </section>

  <!-- Demanda por franja horaria -->
  <section class="mx-auto max-w-[1400px] px-4 pb-20 sm:px-6">
    <figure class="card p-6 lg:p-8">
      <figcaption>
        <h2 class="font-display text-2xl font-extrabold tracking-tight"><%= t('routes.detailDemand') %></h2>
        <p class="mt-2 text-sm" style="color: var(--text-soft)"><%= t('routes.detailDemandNote') %></p>
      </figcaption>

      <div class="relative mt-6 h-[280px]">
        <canvas id="routeDemand"
                aria-label="<%= t('routes.detailDemand') %> — <%= route.id %>"
                role="img"></canvas>
      </div>

      <details class="mt-5">
        <summary class="cursor-pointer text-sm font-semibold" style="color: var(--brand)"><%= t('common.tableView') %></summary>
        <div class="mt-3 overflow-x-auto">
          <table class="w-full min-w-[520px] border-collapse text-sm">
            <caption class="sr-only"><%= t('indicators.tableCaption', { title: t('routes.detailDemand') }) %></caption>
            <thead><tr style="background: var(--surface-sunk)">
              <% hours.forEach(function (h) { %><th scope="col" class="p-2 font-mono text-xs font-semibold" dir="ltr"><%= h %></th><% }); %>
            </tr></thead>
            <tbody><tr>
              <% route.demand.forEach(function (v) { %><td class="border-t p-2 text-center font-mono text-xs" style="border-color: var(--line)"><%= fmt.number.format(v) %></td><% }); %>
            </tr></tbody>
          </table>
        </div>
      </details>
    </figure>
  </section>
</main>

<script id="route-data" type="application/json">
  <%- JSON.stringify({ labels: hours, values: route.demand, id: route.id, axis: t('routes.detailDemand'), locale: ctx.intlTag }) %>
</script>

<%- include('../partials/footer', { pageScript: 'route-detail.js', pageChart: true }) %>

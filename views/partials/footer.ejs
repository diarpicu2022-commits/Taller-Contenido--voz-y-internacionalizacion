<footer class="relative mt-24 overflow-hidden border-t" style="border-color: var(--line); background: var(--surface-sunk)">
  <div class="rule-diagonal absolute inset-x-0 top-0"></div>

  <div class="mx-auto grid max-w-[1400px] gap-10 px-4 py-14 sm:px-6 md:grid-cols-12">
    <div class="md:col-span-5">
      <div class="flex items-center gap-3">
        <span class="grid h-10 w-10 place-items-center rounded-xl shadow-signage" style="background: var(--brand)">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" aria-hidden="true">
            <path d="M4 16.5V7a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v9.5" stroke="#fff" stroke-width="1.8" stroke-linecap="round"/>
            <path d="M4 11h16" stroke="#fff" stroke-width="1.8"/>
            <circle cx="8" cy="18" r="1.6" fill="#fff"/><circle cx="16" cy="18" r="1.6" fill="#fff"/>
          </svg>
        </span>
        <span class="font-display text-xl font-extrabold"><%= t('brand.name') %></span>
      </div>
      <p class="mt-4 max-w-md text-sm leading-relaxed" style="color: var(--text-soft)"><%= t('footer.about') %></p>

      <p class="mt-6 flex flex-wrap items-center gap-2 text-xs" style="color: var(--text-mute)">
        <% ctx.locales.forEach(function (l) { %>
          <a href="/<%= l.prefix %><%= canonicalPath %>" hreflang="<%= l.tag %>" lang="<%= l.tag %>"
             class="link-underline font-mono uppercase tracking-widest"
             style="<%= l.prefix === lang ? 'color: var(--brand); font-weight:600' : '' %>"><%= l.shortName %></a>
        <% }); %>
      </p>
    </div>

    <div class="md:col-span-3">
      <h2 class="eyebrow"><%= t('footer.contactTitle') %></h2>
      <address class="mt-3 space-y-2 text-sm not-italic" style="color: var(--text-soft)">
        <p><%= t('footer.address') %></p>
        <p><a class="link-underline font-mono" href="tel:+576027314912" dir="ltr">+57 602 731 4912</a></p>
        <p><a class="link-underline" href="mailto:comunicaciones@avante.gov.co" dir="ltr">comunicaciones@avante.gov.co</a></p>
      </address>
      <h2 class="eyebrow mt-6"><%= t('footer.hoursTitle') %></h2>
      <p class="mt-2 text-sm" style="color: var(--text-soft)"><%= t('footer.hours') %></p>
    </div>

    <div class="md:col-span-2">
      <h2 class="eyebrow"><%= t('footer.linksTitle') %></h2>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a class="link-underline" style="color: var(--text-soft)" href="<%= href('/rutas') %>"><%= t('nav.rutas') %></a></li>
        <li><a class="link-underline" style="color: var(--text-soft)" href="<%= href('/indicadores') %>"><%= t('nav.indicadores') %></a></li>
        <li><a class="link-underline" style="color: var(--text-soft)" href="<%= href('/pqrs') %>"><%= t('nav.pqrs') %></a></li>
        <li><a class="link-underline" style="color: var(--text-soft)" href="<%= href('/accesibilidad') %>"><%= t('nav.accesibilidad') %></a></li>
        <li><a class="link-underline" style="color: var(--text-soft)" href="<%= href('/auditoria') %>"><%= t('nav.auditoria') %></a></li>
      </ul>
    </div>

    <div class="md:col-span-2">
      <h2 class="eyebrow"><%= t('footer.legalTitle') %></h2>
      <ul class="mt-3 space-y-2 text-sm">
        <% t('footer.legal').forEach(function (item) { %>
          <li><span style="color: var(--text-soft)"><%= item %></span></li>
        <% }); %>
      </ul>
    </div>
  </div>

  <div class="border-t" style="border-color: var(--line)">
    <div class="mx-auto flex max-w-[1400px] flex-col gap-2 px-4 py-5 text-xs sm:flex-row sm:items-center sm:justify-between sm:px-6"
         style="color: var(--text-mute)">
      <p><%= t('footer.rights', { year: year }) %></p>
      <p class="font-mono uppercase tracking-[.14em]"><%= t('footer.madeFor') %></p>
    </div>
    <p class="mx-auto max-w-[1400px] px-4 pb-6 text-[11px] sm:px-6" style="color: var(--text-mute)"><%= t('footer.disclaimer') %></p>
  </div>
</footer>

<script src="/vendor/anime.min.js" defer></script>
<script src="/js/app.js" defer></script>
<% if (typeof pageChart !== 'undefined' && pageChart) { %>
<script src="/vendor/chart.umd.min.js" defer></script>
<script src="/js/chart-base.js" defer></script>
<% } %>
<% if (typeof pageScript !== 'undefined' && pageScript) { %>
<script src="/js/<%= pageScript %>" defer></script>
<% } %>
</body>
</html>
